<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WqvLink.App</RootNamespace>
    <AssemblyName>WqvLink</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon for the .exe in Explorer and the taskbar. Regenerate with tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Images the app loads at runtime, e.g. the window icon (avares://WqvLink/Assets/app.ico). -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Prebuilt Pico firmware, embedded so users never need the Arduino IDE. -->
    <EmbeddedResource Include="..\..\firmware\dist\*.uf2" LogicalName="firmware/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WqvLink.Core\WqvLink.Core.csproj" />
  </ItemGroup>
</Project>
