<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WqvLink.App.ViewModels"
        x:Class="WqvLink.App.Views.PhotoWindow"
        x:DataType="vm:PhotoItem"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <Image Source="{Binding Bitmap}" Width="480" Height="480" RenderOptions.BitmapInterpolationMode="None" />
        <SelectableTextBlock Text="{Binding Details}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Save as…" Classes="accent" Click="Save_Click" />
            <Button Content="Close" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
