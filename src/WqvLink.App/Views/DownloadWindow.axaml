<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WqvLink.App.ViewModels"
        x:Class="WqvLink.App.Views.DownloadWindow"
        x:DataType="vm:DownloadViewModel"
        Title="Get photos from watch"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ProgressBar Height="8" Minimum="0" Maximum="100" IsVisible="{Binding IsRunning}"
                     Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" />
        <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" MinHeight="60" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Show trace log" IsVisible="{Binding CanShowLog}" Click="ShowLog_Click" />
            <Button Content="{Binding StartText}" Classes="accent" IsVisible="{Binding CanStart}" Click="Start_Click"
                    MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Content="{Binding ButtonText}" Click="Close_Click" MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</Window>
