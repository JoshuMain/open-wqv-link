<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WqvLink.App.ViewModels"
        x:Class="WqvLink.App.Views.TestsWindow"
        x:DataType="vm:TestsViewModel"
        Title="Tests"
        Width="760" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}" MinWidth="260"
                          IsEnabled="{Binding !IsRunning}" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBlast}">
                    <TextBlock Text="Seconds" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding BlastSeconds}" Minimum="1" Maximum="120" Increment="1"
                                   FormatString="0" Width="120" IsEnabled="{Binding !IsRunning}" />
                </StackPanel>
                <Button Content="Run" Classes="accent" Click="Run_Click" IsEnabled="{Binding !IsRunning}" MinWidth="70"
                        HorizontalContentAlignment="Center" />
                <Button Content="Stop" Click="Stop_Click" IsEnabled="{Binding IsRunning}" MinWidth="70"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedTest.Instructions}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>
        <TextBox x:Name="Output" Margin="0,10,0,0" Text="{Binding Console.Text}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                 FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
